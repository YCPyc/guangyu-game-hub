{$SITE_ADDRESS} {
	encode gzip
	root * /srv

	# Hashed build assets never change; games and pages should always be fresh.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /games/* Cache-Control "no-cache"

	# Single-page app: unknown paths like /classes/<id> fall back to index.html.
	try_files {path} {path}/ /index.html
	file_server
}
